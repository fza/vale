# Line endings these fixtures exist to test.
CRLF.md text eol=crlf
CR.md text eol=cr

# `internal/lint/code` compares extracted comments and literals against text that
# spells out the line endings it expects, so these have to check out the same
# everywhere -- on Windows, `core.autocrlf` would otherwise rewrite them to CRLF.
# A real run never sees the difference: NewFile turns CRLF into LF first.
testdata/comments/** text eol=lf
internal/lint/code/testdata/** text eol=lf

testdata/** linguist-vendored=true
